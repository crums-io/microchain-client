<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.crums</groupId>
    <artifactId>microchain-client</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>microchain-cli</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>
  <description>
    Command-line client for committing on-prem ledger rows to a microchain.
    Connects directly to the source database, computes row hashes locally,
    and submits them via the microchain REST API.
  </description>

  <dependencies>

    <dependency>
      <groupId>io.crums</groupId>
      <artifactId>microchain-http</artifactId>
      <version>${revision}</version>
    </dependency>

    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>${picocli.version}</version>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.3.232</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- Embeds the module's main class, so jpackage/java -m can launch it
           via just the module name (target/appassembler/repo). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.crums.micro.cli.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Uber jar: java -jar mchain-VERSION.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <finalName>mchain-${revision}</finalName>
              <filters>
                <filter>
                  <!-- drop JPMS descriptors and signature files from deps -->
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.crums.micro.cli.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Launch scripts: target/appassembler/bin/mchain[.bat] -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>appassembler-maven-plugin</artifactId>
        <version>2.1.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>assemble</goal></goals>
          </execution>
        </executions>
        <configuration>
          <programs>
            <program>
              <mainClass>io.crums.micro.cli.Main</mainClass>
              <id>mchain</id>
            </program>
          </programs>
          <repositoryLayout>flat</repositoryLayout>
          <useWildcardClassPath>true</useWildcardClassPath>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>
